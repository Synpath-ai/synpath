# Copy to .env (git-ignored) and fill in what you have. Nothing here reaches
# the repository; `synpath doctor` reports what loads.

# Kalshi: API key id and the RSA private key file (PEM, the BEGIN...END block only).
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/Users/you/.kalshi/kalshi.pem
# prod (the default) trades real money on Kalshi; demo uses Kalshi's practice exchange with a demo key.
KALSHI_ENV=prod

# Polymarket (global CLOB V2). The signer's private key, hex, and the wallet the
# orders spend from: signature type 3 with the Deposit Wallet address as funder
# for any account created since May 2026 (polymarket.com -> profile menu);
# 1 or 2 for legacy proxy / Safe wallets; 0 only for an allowlisted EOA.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_FUNDER=
# Optional: existing CLOB API credentials (derived from the key when absent),
# a builder code, a Relayer API key for gasless approvals / split / merge /
# redeem, and a Polygon RPC endpoint for an EOA's own transactions.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_BUILDER_CODE=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_RPC_URL=

# Polymarket US, retail API (api.polymarket.us): key id and base64 secret from
# polymarket.us/developer after identity verification in the app.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# Polymarket US, exchange API (polymarketexchange.com): an onboarded firm's
# client id, RSA private key file, participant id and trading account.
POLYMARKET_US_CLIENT_ID=
POLYMARKET_US_PRIVATE_KEY_PATH=
POLYMARKET_US_PARTICIPANT_ID=
POLYMARKET_US_ACCOUNT=
POLYMARKET_US_ENV=preprod

# Opinion (opinion.trade, BNB Chain): the private key of the wallet connected
# on opinion.trade, and its Open API key (synpath init creates one by signing
# with that wallet). The key alone also serves the WebSocket and raises the
# market data rate limit. The account's Safe is read from the venue if unset.
OPINION_PRIVATE_KEY=
OPINION_API_KEY=
OPINION_MULTISIG_ADDRESS=

# Hyperliquid (outcome markets, HIP-4): an API wallet's key is safest -- it
# trades but cannot withdraw (app.hyperliquid.xyz -> More -> API). With an API
# wallet, set the account it trades for. HYPERLIQUID_TESTNET=1 uses the test
# network. Market data and streams need none of this.
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_TESTNET=

# predict.fun (BNB Chain): every mainnet request needs an API key, market data
# included. Create one at https://developers.predict.fun. To trade, the key
# that signs: a plain wallet's own, or, for a Predict account (made by the web
# app), its owner key (Account -> Settings -> Privy wallet) with the account's
# deposit address. PREDICT_FUN_TESTNET=1 uses the test network, which needs no
# API key. PREDICT_FUN_RPC_URL (optional) is the node the balance is read from.
PREDICT_FUN_API_KEY=
PREDICT_FUN_PRIVATE_KEY=
PREDICT_FUN_ACCOUNT_ADDRESS=
PREDICT_FUN_TESTNET=
PREDICT_FUN_RPC_URL=

# Limitless (Base): market data needs nothing. To trade, the private key of the
# wallet connected on limitless.exchange (in EOA trading mode) and a scoped API
# token derived there (profile, API tokens, Derive): its id and base64 secret.
# LIMITLESS_RPC_URL (optional) is the Base node the balance is read from.
LIMITLESS_PRIVATE_KEY=
LIMITLESS_API_TOKEN_ID=
LIMITLESS_API_SECRET=
LIMITLESS_RPC_URL=
